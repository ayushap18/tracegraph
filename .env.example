# Required: TypeSafe API key for the Jev router model
TYPESAFE_API_KEY=
# Optional: LLM engine for planning, answers and merging.
# auto uses your installed Claude Code / Codex / Antigravity CLI (your subscription), else the API key below.
TG_ENGINE=auto
# Optional: pay-per-token alternative to a subscription CLI
ANTHROPIC_API_KEY=
# Optional: server port (default 8777)
PORT=8777
