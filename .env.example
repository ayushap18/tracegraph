# Required: TypeSafe API key for the Jev router model
TYPESAFE_API_KEY=
# Optional: LLM engine for planning, answers and merging.
# auto uses your installed Claude Code / Codex / Antigravity / OpenCode CLI (your own login), then any API key below.
TG_ENGINE=auto
# Optional: pay-per-token API keys. Each one that is set becomes an engine (TG_<NAME>_MODEL picks its model).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
# Optional: any other OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, a proxy) as the `api` engine.
# More providers can be listed in data/providers.json (see jevrouter/engines/api.py).
TG_API_BASE_URL=
TG_API_MODEL=
TG_API_KEY=
# Optional: server port (default 8777)
PORT=8777
